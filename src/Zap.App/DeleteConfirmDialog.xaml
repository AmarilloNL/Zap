<Window x:Class="Zap.App.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm delete" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Permanent delete is fast but cannot be undone: files do not go to the Recycle Bin." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="Move to Recycle Bin (slower)" Padding="16,6" Margin="0,0,8,0" Click="Recycle_Click" />
            <Button Content="Delete permanently (fast)" IsDefault="True" Padding="16,6"
                    Background="#C42B1C" Foreground="White" Click="Permanent_Click" />
        </StackPanel>
    </StackPanel>
</Window>
