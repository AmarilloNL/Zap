<Window x:Class="Zap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zap" Width="760" Height="620" MinWidth="560" MinHeight="480">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <TabItem Header="Copy">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Copy these (drop files or folders here)" FontWeight="SemiBold" />
                    <ListBox x:Name="CopyList" Grid.Row="1" Margin="0,6,0,0" AllowDrop="True" SelectionMode="Extended"
                             Drop="List_Drop" DragOver="Drop_DragOver" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add files…" Tag="{Binding ElementName=CopyList}" Click="AddFiles_Click" Margin="0,0,8,0" />
                        <Button Content="Add folder…" Tag="{Binding ElementName=CopyList}" Click="AddFolder_Click" Margin="0,0,8,0" />
                        <Button Content="Remove" Tag="{Binding ElementName=CopyList}" Click="Remove_Click" Margin="0,0,8,0" />
                        <Button Content="Clear" Tag="{Binding ElementName=CopyList}" Click="Clear_Click" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="To folder" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <DockPanel Grid.Row="4" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDest_Click" Margin="8,0,0,0" />
                        <TextBox x:Name="DestBox" AllowDrop="True" PreviewDragOver="Drop_DragOver" PreviewDrop="Dest_Drop" />
                    </DockPanel>
                    <DockPanel Grid.Row="5" Margin="0,16,0,0">
                        <Button x:Name="StartCopyButton" DockPanel.Dock="Right" Content="Start copy" Padding="24,8"
                                Style="{DynamicResource AccentButtonStyle}" Click="StartCopy_Click" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="If a file already exists:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="OverwriteBox" SelectedIndex="0" Width="200">
                                <ComboBoxItem Content="Skip identical" />
                                <ComboBoxItem Content="Always overwrite" />
                                <ComboBoxItem Content="Never overwrite" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Delete">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Delete these (drop files or folders here)" FontWeight="SemiBold" />
                    <ListBox x:Name="DeleteList" Grid.Row="1" Margin="0,6,0,0" AllowDrop="True" SelectionMode="Extended"
                             Drop="List_Drop" DragOver="Drop_DragOver" />
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete…" Padding="24,8"
                                Background="#C42B1C" Foreground="White" Click="Delete_Click" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add files…" Tag="{Binding ElementName=DeleteList}" Click="AddFiles_Click" Margin="0,0,8,0" />
                            <Button Content="Add folder…" Tag="{Binding ElementName=DeleteList}" Click="AddFolder_Click" Margin="0,0,8,0" />
                            <Button Content="Remove" Tag="{Binding ElementName=DeleteList}" Click="Remove_Click" Margin="0,0,8,0" />
                            <Button Content="Clear" Tag="{Binding ElementName=DeleteList}" Click="Clear_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="Ready." FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Bar" Height="8" Margin="0,8,0,0" Maximum="1" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsEnabled="False" Click="Cancel_Click" />
                <TextBlock x:Name="DetailText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Expander x:Name="ErrorsExpander" Visibility="Collapsed" Margin="0,8,0,0">
                <ListBox x:Name="ErrorList" MaxHeight="160" />
            </Expander>
        </StackPanel>
    </Grid>
</Window>
