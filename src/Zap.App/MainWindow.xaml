<Window x:Class="Zap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zap.App"
        Title="Zap" Width="1000" Height="720" MinWidth="880" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#030712"
        FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource InkBrush}"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource PageBackground}">
        <!-- ============ Aurora backdrop ============ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="680" Height="680" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-300,0,0"
                     Fill="{DynamicResource BlobABrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobAMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-300,0"
                     Fill="{StaticResource BlobBBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobBMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-360"
                     Fill="{StaticResource BlobCBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobCMove" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="24" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="BlobAMove" Storyboard.TargetProperty="X" To="180" Duration="0:0:16">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobAMove" Storyboard.TargetProperty="Y" To="120" Duration="0:0:13">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobBMove" Storyboard.TargetProperty="X" To="-200" Duration="0:0:18">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobBMove" Storyboard.TargetProperty="Y" To="140" Duration="0:0:15">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobCMove" Storyboard.TargetProperty="X" To="220" Duration="0:0:17">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="BlobCMove" Storyboard.TargetProperty="Y" To="-120" Duration="0:0:14">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar ============ -->
            <DockPanel Margin="18,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentGradient}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Zap" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- ============ Header ============ -->
            <DockPanel Grid.Row="1" Margin="36,14,36,22">
                <Border x:Name="ModeHost" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="22" Padding="4"
                        Background="#0FFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CopyMode" GroupName="Mode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MoveMode" GroupName="Mode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" Margin="0,0,8,0" />
                                <TextBlock Text="Move" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="DeleteMode" GroupName="Mode" Style="{StaticResource SegmentRadio}" Checked="Mode_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <ContentControl Style="{StaticResource Eyebrow}" Content="FAST FILE TOOL" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DisplayText}" FontSize="36" Margin="0,6,0,0" />
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="2" Margin="36,0,36,32">
                <!-- ============ Idle view ============ -->
                <Grid x:Name="IdleView">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <!-- Items / drop zone -->
                    <ContentControl Style="{StaticResource GlassPanel}" Padding="14">
                        <Grid>
                            <Rectangle x:Name="DropOutline" RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       Stroke="{StaticResource LineBrightBrush}" Fill="Transparent" />
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                    <Border CornerRadius="24" Background="{DynamicResource AccentGradient}" Opacity="0.18" />
                                    <Border CornerRadius="24" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0.5" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="18" ShadowDepth="0" Opacity="0.9" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Drop files or folders here" Style="{StaticResource DisplayText}" FontSize="22"
                                           HorizontalAlignment="Center" Margin="0,20,0,0" />
                                <TextBlock x:Name="EmptyHint" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button Style="{StaticResource GhostButton}" Click="AddFiles_Click" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0" />
                                            <TextBlock Text="Add files" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EmptyAddFolder" Style="{StaticResource GhostButton}" Click="AddFolder_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                            <TextBlock Text="Add folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <DockPanel x:Name="ListState" Margin="12" Visibility="Collapsed">
                                <DockPanel DockPanel.Dock="Top" Margin="4,2,0,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Click="AddFiles_Click" Margin="0,0,8,0" ToolTip="Add files">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Files" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Click="AddFolder_Click" Margin="0,0,8,0" ToolTip="Add a folder">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                                <TextBlock Text="Folder" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Click="Clear_Click">
                                            <TextBlock Text="Clear" FontSize="12.5" />
                                        </Button>
                                    </StackPanel>
                                    <ContentControl x:Name="ItemsEyebrow" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ItemsView">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PathItem}">
                                                <Border CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1"
                                                        Padding="14,10,8,10" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundIconButton}" Content="&#xE711;"
                                                                Tag="{Binding}" Click="RemoveItem_Click" ToolTip="Remove from list" />
                                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20"
                                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Parent}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </ContentControl>

                    <!-- Copy options -->
                    <ContentControl x:Name="CopySide" Grid.Column="2" Style="{StaticResource GlassPanel}">
                        <DockPanel>
                            <Button x:Name="StartCopyButton" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="StartCopy_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" Margin="0,0,10,0" />
                                    <TextBlock x:Name="StartText" Text="Start copy" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <ContentControl Style="{StaticResource Eyebrow}" Content="DESTINATION" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,0" Margin="8,0,0,0"
                                            Click="BrowseDest_Click" ToolTip="Browse for a folder">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="15" />
                                    </Button>
                                    <TextBox x:Name="DestBox" Style="{StaticResource GlassTextBox}" Tag="Pick or drop a folder…"
                                             AllowDrop="True" PreviewDragOver="Dest_DragOver" PreviewDrop="Dest_Drop" />
                                </DockPanel>
                                <ContentControl Style="{StaticResource Eyebrow}" Content="IF A FILE ALREADY EXISTS" Margin="0,26,0,12" />
                                <RadioButton x:Name="OverSkip" GroupName="Overwrite" Style="{StaticResource ChoiceCard}" IsChecked="True"
                                             Content="Skip identical" Tag="Same size and date? Skip it. Re-runs are quick." />
                                <RadioButton x:Name="OverAlways" GroupName="Overwrite" Style="{StaticResource ChoiceCard}"
                                             Content="Always overwrite" Tag="Replace every file that already exists." />
                                <RadioButton x:Name="OverNever" GroupName="Overwrite" Style="{StaticResource ChoiceCard}"
                                             Content="Never overwrite" Tag="Keep whatever is already there." />
                            </StackPanel>
                        </DockPanel>
                    </ContentControl>

                    <!-- Delete info -->
                    <ContentControl x:Name="DeleteSide" Grid.Column="2" Style="{StaticResource GlassPanel}" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="DeleteButton" DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,10,0" />
                                    <TextBlock Text="Delete…" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <ContentControl Style="{StaticResource Eyebrow}" Content="HOW IT WORKS" Margin="0,0,0,18" />
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="Zap counts everything first" FontWeight="SemiBold" />
                                        <TextBlock Text="You see how many files and GB before anything happens." Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="You choose how" FontWeight="SemiBold" />
                                        <TextBlock Text="Permanent (fast, can't be undone) or the Recycle Bin (slower)." Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="18"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="System folders are off-limits" FontWeight="SemiBold" />
                                        <TextBlock Text="Windows, Program Files, your user folder and whole drives are always refused."
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </ContentControl>
                </Grid>

                <!-- ============ Job view ============ -->
                <Grid x:Name="JobView" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="290" Height="290" VerticalAlignment="Center">
                        <local:ProgressRing x:Name="Ring" Thickness="16" Stroke="{DynamicResource AccentGradient}" RenderTransformOrigin="0.5,0.5">
                            <local:ProgressRing.RenderTransform>
                                <RotateTransform />
                            </local:ProgressRing.RenderTransform>
                            <local:ProgressRing.Effect>
                                <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="40" ShadowDepth="0" Opacity="0.75" />
                            </local:ProgressRing.Effect>
                        </local:ProgressRing>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="RingText" Style="{StaticResource DisplayText}" FontSize="60" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RingGlyph" Style="{StaticResource Icon}" FontSize="64" HorizontalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="RingSub" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <ContentControl Grid.Column="2" Style="{StaticResource GlassPanel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Padding="22,11" Click="Cancel_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" Margin="0,0,8,0" />
                                        <TextBlock Text="Cancel" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Width="150" Click="Done_Click" Visibility="Collapsed">
                                    <TextBlock Text="Done" />
                                </Button>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top">
                                <ContentControl x:Name="JobEyebrow" Style="{StaticResource Eyebrow}" />
                                <TextBlock x:Name="JobHeadline" Style="{StaticResource DisplayText}" FontSize="22" Margin="0,8,0,0"
                                           TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CurrentText" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <UniformGrid Columns="2" Margin="0,18,-10,0">
                                    <HeaderedContentControl x:Name="SpeedCell" Style="{StaticResource MetricCell}" Header="SPEED" Padding="0,0,10,10">
                                        <TextBlock x:Name="SpeedText" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl x:Name="TimeCell" Style="{StaticResource MetricCell}" Header="TIME LEFT" Padding="0,0,10,10">
                                        <TextBlock x:Name="TimeText" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl x:Name="FilesCell" Style="{StaticResource MetricCell}" Header="FILES" Padding="0,0,10,10">
                                        <TextBlock x:Name="FilesText" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource MetricCell}" Header="DATA" Padding="0,0,10,10">
                                        <TextBlock x:Name="BytesText" />
                                    </HeaderedContentControl>
                                </UniformGrid>
                            </StackPanel>

                            <Grid Margin="0,8,0,0">
                                <local:SpeedGraph x:Name="Graph" Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentFade}" MinHeight="60" />
                                <DockPanel x:Name="ErrorsPanel" Visibility="Collapsed">
                                    <ContentControl x:Name="ErrorsEyebrow" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Margin="0,0,0,10" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ErrorList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Path}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#FBBF24" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
