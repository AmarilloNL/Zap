<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Cosmic glass tokens ============ -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="InkBrush" Color="#EEF6FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8B9BB4" />
    <SolidColorBrush x:Key="SoftBrush" Color="#536279" />
    <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="LineBrightBrush" Color="#47B3E5FF" />

    <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#02040C" Offset="0" />
        <GradientStop Color="#051126" Offset="0.46" />
        <GradientStop Color="#050514" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40B3E5FF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.5" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent: overridden per mode by MainWindow (copy = cyan/violet, delete = magenta/red) -->
    <Color x:Key="Accent1">#22D3EE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1F22D3EE" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5922D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BlobABrush">
        <GradientStop Color="#4D22D3EE" Offset="0" />
        <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobBBrush">
        <GradientStop Color="#478B5CF6" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BlobCBrush">
        <GradientStop Color="#2EF472B6" Offset="0" />
        <GradientStop Color="#00F472B6" Offset="1" />
    </RadialGradientBrush>

    <!-- ============ Text ============ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tiny uppercase kicker with a glowing accent dot -->
    <Style x:Key="Eyebrow" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Panels ============ -->
    <!-- The shadow lives on a sibling border so scrolling content isn't re-rendered through the effect -->
    <Style x:Key="GlassPanel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="22" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetricCell" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border CornerRadius="14" Background="#08FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                            Padding="14,11" Margin="{TemplateBinding Padding}">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource MutedBrush}" />
                            <ContentPresenter Margin="0,3,0,0" TextElement.FontSize="20" TextElement.FontWeight="SemiBold"
                                              TextElement.FontFamily="{StaticResource DisplayFont}"
                                              TextElement.Foreground="{StaticResource InkBrush}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Buttons ============ -->
    <!-- The one gradient button per view, with glow and a light sweep on hover -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Pill" RadiusX="25" RadiusY="25" Fill="{DynamicResource AccentGradient}">
                            <Rectangle.Effect>
                                <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
                            </Rectangle.Effect>
                        </Rectangle>
                        <Rectangle x:Name="Sweep" RadiusX="25" RadiusY="25">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00FFFFFF" Offset="0.3" />
                                    <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sweep"
                                                         Storyboard.TargetProperty="(Shape.Fill).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1" To="1" Duration="0:0:0.8" />
                                        <DoubleAnimation Storyboard.TargetName="Pill"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="36" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Pill"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.8" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                         To="22" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Pill"
                                                         Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         To="0.45" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="18" Background="#0DFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="14" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Toggles ============ -->
    <!-- Pill segment for the Copy | Delete switch -->
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Fill" CornerRadius="18" Background="{DynamicResource AccentGradient}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="18" ShadowDepth="0" Opacity="0.5" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable card: Content = title, Tag = one-line hint -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="14" Padding="14,10" Background="#08FFFFFF"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource SoftBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Opacity="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource Accent1}" BlurRadius="10" ShadowDepth="0" Opacity="1" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <StackPanel>
                                <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.FontSize="13.5" />
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Inputs ============ -->
    <!-- Tag = placeholder text -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource SoftBrush}" Margin="15,0,12,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Slim scrollbars ============ -->
    <Style x:Key="InvisibleRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource AccentGradient}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource InvisibleRepeat}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource InvisibleRepeat}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SlimThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="6" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource InvisibleRepeat}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource InvisibleRepeat}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
